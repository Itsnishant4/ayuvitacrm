{
  "name": "ayuvitaCRM",
  "version": "1.5.4",
  "description": "CRM Desktop Application",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "node scripts/dev-electron-watch.js",
    "dev:electron:plain": "electron .",
    "build": "vite build",
    "build:win": "npm run build && npx electron-builder --win --x64",
    "build:mac": "npm run build && npx electron-builder --mac"
  },
  "build": {
    "appId": "com.crm.app",
    "productName": "ayuvitaCRM",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      ".env",
      "dist",
      "main.js",
      "preload.js",
      "database"
    ],
    "icon": "icon/windows/icon.ico",
    "publish": {
      "provider": "github",
      "owner": "itsnishant4",
      "repo": "ayuvitacrm",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "icon/macos/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "icon/windows/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "include": "installer.nsh",
      "installerIcon": "icon/windows/icon.ico",
      "uninstallerIcon": "icon/windows/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ayuvitaCRM",
      "uninstallDisplayName": "ayuvitaCRM ${version}",
      "deleteAppDataOnUninstall": false,
      "guid": "55f5e27a-8d1a-4f4b-8d1c-8e8e8e8e8e8e"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "npm",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-reload": "^2.0.0-alpha.1",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/vite": "^4.2.4",
    "adm-zip": "^0.5.17",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "pdfjs-dist": "^5.6.205",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.2.6",
    "recharts": "^3.8.1",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0"
  }
}
