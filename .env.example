# RefCRM Environment Variables
# Copy this file to .env and fill in your values

# JWT Secret for token signing (generate a strong random string in production)
# If not set, a random secret will be generated (requires re-login on restart)
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars

# Admin Panel URL for update checks
ADMIN_URL=http://localhost:3000

# --- Supabase (cloud store for referral partners) ---
supabase_url=https://your-project.supabase.co
anon=sb_publishable_xxxxxxxxxxxx
# Shared secret required by the token-gated RLS policy in database/supabase-setup.sql
SUPABASE_RLS_SECRET=

# --- Shopify cloud sync ---
# Seeded into the local DB on first run; values edited in the app (DB) always win.
SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxx
SHOPIFY_CLIENT_ID=xxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=xxxxxxxxxxxx
